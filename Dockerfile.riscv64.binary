# syntax=docker/dockerfile:1.7-labs

FROM rust:bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    pkg-config \
    wget \
    gcc-riscv64-linux-gnu \
    g++-riscv64-linux-gnu \
    libc6-dev-riscv64-cross \
    && rm -rf /var/lib/apt/lists/*

# libdbus-1-dev has no riscv64 package in Debian Bookworm — build from source
RUN cd /tmp && wget -q https://github.com/libexpat/libexpat/releases/download/R_2_6_4/expat-2.6.4.tar.bz2 && \
    tar xf expat-2.6.4.tar.bz2 && cd expat-2.6.4 && \
    ./configure --host=riscv64-linux-gnu CC=riscv64-linux-gnu-gcc CFLAGS=-fPIC \
        --prefix=/usr/riscv64-linux-gnu --enable-static --disable-shared --without-docbook && \
    make -j$(nproc) && make install

RUN cd /tmp && wget -q https://dbus.freedesktop.org/releases/dbus/dbus-1.14.10.tar.xz && \
    tar xf dbus-1.14.10.tar.xz && cd dbus-1.14.10 && \
    ./configure --host=riscv64-linux-gnu CC=riscv64-linux-gnu-gcc CFLAGS=-fPIC \
        --prefix=/usr/riscv64-linux-gnu --enable-static --disable-shared \
        --disable-systemd --disable-selinux --disable-tests --disable-xml-docs --disable-doxygen-docs --without-x \
        PKG_CONFIG_PATH=/usr/riscv64-linux-gnu/lib/pkgconfig ac_cv_func_pipe2=yes && \
    make -j$(nproc) && make install

ENV PKG_CONFIG_ALLOW_CROSS=1 \
    PKG_CONFIG_PATH=/usr/riscv64-linux-gnu/lib/pkgconfig

RUN rustup target add riscv64gc-unknown-linux-gnu

WORKDIR /usr/src/app

COPY Cargo.toml Cargo.lock build.rs ./
COPY src/protos ./src/protos

RUN mkdir -p src && printf 'fn main() {}\n' > src/main.rs

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo build --release --target riscv64gc-unknown-linux-gnu || true

COPY . .

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo build --release --target riscv64gc-unknown-linux-gnu

FROM scratch AS export
COPY --from=builder /usr/src/app/target/riscv64gc-unknown-linux-gnu/release/aa-proxy-rs /aa-proxy-rs

# DOCKER_BUILDKIT=1 docker build -f Dockerfile.riscv64.binary --target export --output type=local,dest=./output .